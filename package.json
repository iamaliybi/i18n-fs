{
	"name": "i18n-fs-monorepo",
	"private": true,
	"version": "0.0.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"bootstrap": "npm install && npm run wasm:build && npm run wasm:sync && npm run build",
		"core:fmt": "cargo fmt --all -- --check",
		"core:lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
		"core:test": "cargo test --workspace --all-features",
		"core:test:minimal": "cargo test -p i18n-fs-core --no-default-features",
		"core:bench": "cargo bench -p i18n-fs-core",
		"wasm:build": "node scripts/build-wasm.mjs",
		"wasm:sync": "node scripts/sync-wasm.mjs",
		"build": "npm run build --workspace=i18n-fs",
		"typecheck": "npm run typecheck --workspace=i18n-fs",
		"check:docs": "node scripts/check-docs.mjs",
		"docs:nav": "node scripts/docs-nav.mjs",
		"docs:nav:check": "node scripts/docs-nav.mjs --check",
		"measure": "node scripts/measure.mjs",
		"measure:check": "node scripts/measure.mjs --check",
		"test": "npm run test --workspace=i18n-fs",
		"example": "npm run build --workspace=example-next-16-proxy --workspace=example-next-15-middleware --workspace=example-next-14-react-18",
		"example:test": "npm run test --workspace=example-next-16-proxy --workspace=example-next-15-middleware --workspace=example-next-14-react-18",
		"changeset": "changeset",
		"changeset:version": "changeset version && npm install --package-lock-only",
		"changeset:publish": "changeset publish",
		"release": "npm run wasm:build && npm run wasm:sync && npm run build && npm run measure:check && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.7"
	},
	"workspaces": [
		"packages/*",
		"examples/*"
	]
}
