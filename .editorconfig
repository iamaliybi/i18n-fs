root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# YAML forbids tabs at the specification level, so these have to stay spaces.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown here contains ASCII diagrams and aligned tables. Tab indentation
# would reflow them and also changes list-continuation semantics.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
