{
	"name": "i18n-fs",
	"version": "0.7.3",
	"description": "Folder-based i18n for Next.js, with a Rust core compiled to WebAssembly.",
	"keywords": [
		"i18n",
		"internationalization",
		"localization",
		"nextjs",
		"next",
		"react",
		"app-router",
		"react-server-components",
		"rust",
		"webassembly",
		"wasm"
	],
	"license": "MIT",
	"author": "iamaliybi",
	"homepage": "https://github.com/iamaliybi/i18n-fs#readme",
	"bugs": {
		"url": "https://github.com/iamaliybi/i18n-fs/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iamaliybi/i18n-fs.git",
		"directory": "packages/i18n-fs"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"bin",
		"dist",
		"src",
		"wasm",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./navigation": {
			"types": "./dist/navigation.d.ts",
			"default": "./dist/navigation.js"
		},
		"./middleware": {
			"types": "./dist/middleware.d.ts",
			"default": "./dist/middleware.js"
		},
		"./proxy": {
			"types": "./dist/proxy.d.ts",
			"default": "./dist/proxy.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#core-bindings": {
			"edge-light": "./dist/core/bindings.edge.js",
			"workerd": "./dist/core/bindings.edge.js",
			"browser": "./dist/core/bindings.browser.js",
			"node": "./dist/core/bindings.node.js",
			"default": "./dist/core/bindings.edge.js"
		}
	},
	"bin": {
		"i18n-fs": "bin/i18n-fs.mjs"
	},
	"scripts": {
		"build": "tsup && node scripts/postbuild.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "node scripts/verify-package.mjs"
	},
	"peerDependencies": {
		"next": "^14.2.0 || ^15.0.0 || ^16.0.0",
		"react": "^18.3.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		}
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.0",
		"@types/node": "^22.18.0",
		"@types/react": "^19.2.2",
		"esbuild": "^0.27.7",
		"jsdom": "^26.1.0",
		"next": "^15.5.4",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.18"
	}
}
